# ================================================
# NETWORK IDS PROJECT - Custom Snort 3 Rules
# Author: Ansh
# Version: 2.0 (Clean)
# ================================================

# Rule 1: ICMP Ping Detection
alert icmp any any -> any any (msg:"[RECON] ICMP Ping Sweep Detected"; sid:1000001; rev:1;)

# Rule 2: SYN Port Scan
alert tcp any any -> any any (msg:"[SCAN] SYN Port Scan Detected"; flags:S; detection_filter: track by_src, count 20, seconds 3; sid:1000002; rev:1;)

# Rule 3: SSH Brute Force
alert tcp any any -> any 22 (msg:"[BRUTE] SSH Brute Force Attempt"; detection_filter: track by_src, count 5, seconds 60; sid:1000003; rev:1;)

# Rule 4: HTTP Flood DoS
alert tcp any any -> any 80 (msg:"[DOS] HTTP Flood Attack Detected"; detection_filter: track by_src, count 100, seconds 5; sid:1000004; rev:1;)

# Rule 5: Reverse Shell Port 4444
alert tcp any any -> any 4444 (msg:"[CRITICAL] Reverse Shell - Port 4444 Detected"; sid:1000005; rev:1;)

# Rule 6: FTP Connection
alert tcp any any -> any 21 (msg:"[WARN] FTP Connection Attempt Detected"; sid:1000006; rev:1;)

# Rule 7: Telnet Connection
alert tcp any any -> any 23 (msg:"[WARN] Telnet Insecure Protocol Detected"; sid:1000007; rev:1;)

# Rule 8: Nmap OS Fingerprint
alert tcp any any -> any any (msg:"[SCAN] Nmap OS Fingerprint Attempt"; flags:SF; sid:1000008; rev:1;)

# Rule 9: UDP Flood
alert udp any any -> any any (msg:"[DOS] UDP Flood Attack Detected"; detection_filter: track by_src, count 1000, seconds 5; sid:1000009; rev:1;)

# Rule 10: DNS High Frequency
alert udp any any -> any 53 (msg:"[SUSPICIOUS] High-Frequency DNS Query"; detection_filter: track by_src, count 50, seconds 3; sid:1000010; rev:1;)
